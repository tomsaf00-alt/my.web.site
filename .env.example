# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Canonical site origin used for sitemap.xml and static prerendering
VITE_SITE_URL="https://sellermath.app"

# Optional Google AdSense Publisher ID (e.g. ca-pub-1234567890123456)
# Leave empty to hide unapproved AdSense containers in production
VITE_ADSENSE_CLIENT=""

# Optional serverless contact form endpoint (e.g. Formspree or Cloudflare Worker)
VITE_CONTACT_ENDPOINT=""
